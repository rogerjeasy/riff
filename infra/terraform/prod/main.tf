# Riff production: one Lightsail host, its static IP and firewall, and the secrets the
# deploy pipeline renders onto it. Applied automatically by .github/workflows/deploy.yml.
terraform {
  required_version = ">= 1.10"
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 6.0" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
  backend "s3" {
    bucket       = "riff-tfstate-707938860881"
    key          = "prod/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { project = "riff", managed-by = "terraform", stack = "riff-prod" }
  }
}

# These were created before Terraform managed them; adopt them instead of recreating,
# which keeps the static IP (and every Twitch redirect URL built on it) unchanged.
import {
  to = aws_lightsail_instance.host
  id = "riff-prod"
}
import {
  to = aws_lightsail_static_ip.host
  id = "riff-prod-ip"
}
import {
  to = aws_lightsail_static_ip_attachment.host
  id = "riff-prod-ip"
}

resource "aws_lightsail_instance" "host" {
  name              = "riff-prod"
  availability_zone = "${var.region}a"
  blueprint_id      = var.blueprint_id
  bundle_id         = var.bundle_id
  key_pair_name     = var.key_pair_name
  user_data         = file("${path.module}/../../deploy/bootstrap.sh")

  add_on {
    type          = "AutoSnapshot"
    snapshot_time = "06:00"
    status        = "Enabled"
  }

  lifecycle {
    # Replacing the host would discard every streamer's data volume.
    prevent_destroy = true
    # First-boot settings are not readable after creation and never change a running host.
    ignore_changes = [user_data, key_pair_name, tags, tags_all]
  }
}

resource "aws_lightsail_static_ip" "host" {
  name = "riff-prod-ip"
  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_lightsail_static_ip_attachment" "host" {
  static_ip_name = aws_lightsail_static_ip.host.name
  instance_name  = aws_lightsail_instance.host.name
}

resource "aws_lightsail_instance_public_ports" "host" {
  instance_name = aws_lightsail_instance.host.name
  port_info {
    protocol  = "tcp"
    from_port = 22
    to_port   = 22
  }
  port_info {
    protocol  = "tcp"
    from_port = 80
    to_port   = 80
  }
  port_info {
    protocol  = "tcp"
    from_port = 443
    to_port   = 443
  }
  port_info {
    protocol  = "udp"
    from_port = 443
    to_port   = 443
  }
}

# Per-streamer secrets. Removing a name from var.streamers removes its secrets; the
# deploy then stops that streamer's container (its data volume is kept).
resource "random_password" "console" {
  for_each = toset(var.streamers)
  length   = 24
  special  = false
}
resource "random_password" "access" {
  for_each = toset(var.streamers)
  length   = 40
  special  = false
}
resource "random_password" "riff_secret" {
  for_each = toset(var.streamers)
  length   = 48
  special  = false
}

resource "aws_secretsmanager_secret" "streamers" {
  name                    = "riff/prod/streamers"
  description             = "Riff per-streamer secrets (generated by Terraform)"
  recovery_window_in_days = 7
}
resource "aws_secretsmanager_secret_version" "streamers" {
  secret_id = aws_secretsmanager_secret.streamers.id
  secret_string = jsonencode({
    for name in var.streamers : name => {
      RIFF_SECRET             = random_password.riff_secret[name].result
      CONSOLE_PASSWORD        = random_password.console[name].result
      CONSOLE_PASSWORD_BCRYPT = random_password.console[name].bcrypt_hash
      ACCESS_TOKEN            = random_password.access[name].result
    }
  })
}

# Shared integration settings. Terraform creates the secret with safe defaults and then
# never touches its value: set Twitch/OpenAI credentials in Secrets Manager directly.
resource "aws_secretsmanager_secret" "shared" {
  name                    = "riff/prod/shared"
  description             = "Riff shared settings: Twitch app, compiler mode, OpenAI key"
  recovery_window_in_days = 7
}
resource "aws_secretsmanager_secret_version" "shared" {
  secret_id = aws_secretsmanager_secret.shared.id
  secret_string = jsonencode({
    RIFF_COMPILER_MODE   = "mock"
    TWITCH_CLIENT_ID     = ""
    TWITCH_CLIENT_SECRET = ""
    OPENAI_API_KEY       = ""
    ACME_EMAIL           = ""
  })
  lifecycle {
    ignore_changes = [secret_string]
  }
}

# The SSH key the pipeline uses to reach the host. Its value is the private half of the
# Lightsail key pair named in var.key_pair_name, uploaded once (see infra/deploy/README.md).
resource "aws_secretsmanager_secret" "deploy" {
  name                    = "riff/prod/deploy"
  description             = "Riff deploy SSH private key for the Lightsail host"
  recovery_window_in_days = 7
}
