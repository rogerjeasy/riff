#!/usr/bin/env bash
# riffctl — the server side of Riff's automated deployment.
#
# One isolated app container per streamer (own SQLite volume, secret, subdomain and
# overlay key) behind one Caddy that provides automatic HTTPS and a per-streamer
# console login. The overlay, its socket, peer collaboration routes and the health check
# stay public: they carry their own keys/bearers and OBS cannot answer a login prompt.
#
# The deploy pipeline calls `riffctl sync <image-tag>` with a JSON spec on stdin, built
# from Terraform outputs and AWS Secrets Manager. The rest is for looking around:
#   riffctl status | logs <name> | backup
set -euo pipefail

ROOT=${RIFF_ROOT:-/opt/riff}
DEPLOY=$ROOT/deploy
TENANTS=$DEPLOY/tenants
BACKUPS=$ROOT/backups
CONF=$DEPLOY/riff.conf
CADDY_IMAGE=caddy:2.11.7-alpine

die() { echo "riffctl: $*" >&2; exit 1; }
conf() {
  [[ -f $CONF ]] || die "not deployed yet (no $CONF)"
  # shellcheck source=/dev/null
  source "$CONF"
}
compose() { docker compose -p riff -f "$DEPLOY/compose.yaml" "$@"; }
tenants() { find "$TENANTS" -maxdepth 1 -name '*.env' -exec basename {} .env \; 2>/dev/null | sort; }

render() {
  conf
  mkdir -p "$DEPLOY/caddy"
  local names; names=$(tenants)
  {
    echo "# Generated by riffctl. Do not edit by hand."
    echo "name: riff"
    echo "services:"
    echo "  caddy:"
    echo "    image: $CADDY_IMAGE"
    echo "    restart: unless-stopped"
    echo "    ports: ['80:80', '443:443', '443:443/udp']"
    echo "    volumes:"
    echo "      - ./caddy:/etc/caddy:ro"
    echo "      - caddy-data:/data"
    echo "      - caddy-config:/config"
    for name in $names; do
      cat <<YAML
  app-$name:
    image: riff:current
    restart: unless-stopped
    init: true
    env_file: [./shared.env, ./tenants/$name.env]
    volumes: ['data-$name:/opt/riff/data']
    read_only: true
    tmpfs: ['/tmp:size=256m,mode=1777']
    cap_drop: [ALL]
    security_opt: ['no-new-privileges:true']
    pids_limit: 256
    mem_limit: 640m
    cpus: 1.0
    stop_grace_period: 15s
YAML
    done
    echo "volumes:"
    echo "  caddy-data:"
    echo "  caddy-config:"
    for name in $names; do echo "  data-$name:"; done
  } > "$DEPLOY/compose.yaml.next"
  {
    echo "# Generated by riffctl. Do not edit by hand."
    if [[ -n ${ACME_EMAIL:-} ]]; then printf '{\n\temail %s\n}\n' "$ACME_EMAIL"; fi
    for name in $names; do
      # Never let one streamer's values leak into the next block.
      HASH='' ACCESS=''
      # shellcheck source=/dev/null
      source "$TENANTS/$name.auth"
      [[ $HASH == \$2* ]] || die "$name has no valid password hash"
      # Only a real 40-character token may enable the cookie route (an empty one would match anything).
      [[ $ACCESS =~ ^[A-Za-z0-9]{40}$ ]] || die "$name has no valid sign-in token"
      cat <<CADDY

$name.$BASE_DOMAIN {
	encode gzip
	header -Server
	# Public by design: OBS overlay (key-protected socket), static assets, peer
	# collaboration (scoped bearer tokens) and the health check.
	@open path /overlay /overlay/* /assets/* /ws/overlay /peer/* /api/health
	handle @open {
		reverse_proxy app-$name:8787
	}
	# Private sign-in link (for the OBS dock, which cannot answer a password prompt):
	# store a 30-day HttpOnly cookie, then drop the token from the address bar.
	@link query access=$ACCESS
	handle @link {
		header Set-Cookie "riff_access=$ACCESS; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"
		redir {path} 302
	}
	@signed header Cookie *riff_access=$ACCESS*
	handle @signed {
		reverse_proxy app-$name:8787
	}
	# Everything else is this streamer's private console, dock and API.
	handle {
		basic_auth {
			$name $HASH
		}
		reverse_proxy app-$name:8787
	}
}
CADDY
    done
  } > "$DEPLOY/caddy/Caddyfile.next"
  mv "$DEPLOY/compose.yaml.next" "$DEPLOY/compose.yaml"
  # The directory (not the file) is mounted, so Caddy sees the replaced file on reload.
  mv "$DEPLOY/caddy/Caddyfile.next" "$DEPLOY/caddy/Caddyfile"
}

apply() {
  render
  compose up -d --remove-orphans
  # Caddy re-reads its config without dropping live overlay connections.
  compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
}

# Write config files from the spec in $DEPLOY/spec.json. Values never appear in argv or logs.
write_spec() {
  mkdir -p "$TENANTS" "$BACKUPS"
  umask 077
  python3 - "$DEPLOY" <<'PY'
import json, os, re, sys
deploy = sys.argv[1]
spec = json.load(open(os.path.join(deploy, 'spec.json')))
safe = re.compile(r'^[A-Za-z0-9._:/@+=,$-]*$')
def check(key, value):
    value = '' if value is None else str(value)
    if not safe.match(value) or len(value) > 512:
        sys.exit(f'riffctl: refusing unsafe value for {key}')
    return value
def write(path, lines):
    tmp = path + '.next'
    with open(tmp, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
domain = check('base_domain', spec['base_domain'])
if not re.match(r'^[a-z0-9.-]+$', domain):
    sys.exit('riffctl: invalid base domain')
shared = spec.get('shared', {})
email = check('ACME_EMAIL', shared.get('ACME_EMAIL', ''))
write(os.path.join(deploy, 'riff.conf'), [f'BASE_DOMAIN={domain}', f'ACME_EMAIL={email}'])
mode = check('RIFF_COMPILER_MODE', shared.get('RIFF_COMPILER_MODE') or 'mock')
if mode not in ('mock', 'codex'):
    sys.exit('riffctl: RIFF_COMPILER_MODE must be mock or codex')
lines = ['NODE_ENV=production', 'LOG_LEVEL=info', f'RIFF_COMPILER_MODE={mode}']
for key in ('OPENAI_API_KEY', 'TWITCH_CLIENT_ID', 'TWITCH_CLIENT_SECRET'):
    if '$' in str(shared.get(key, '')):
        sys.exit(f'riffctl: refusing unsafe value for {key}')
    lines.append(f"{key}={check(key, shared.get(key, ''))}")
write(os.path.join(deploy, 'shared.env'), lines)
tenants = os.path.join(deploy, 'tenants')
wanted = set()
for name, values in spec['streamers'].items():
    if not re.match(r'^[a-z][a-z0-9-]{0,19}$', name):
        sys.exit(f'riffctl: invalid streamer name {name!r}')
    wanted.add(name)
    url = f'https://{name}.{domain}'
    secret = check('RIFF_SECRET', values['RIFF_SECRET'])
    if len(secret) < 32 or '$' in secret:
        sys.exit('riffctl: RIFF_SECRET must be at least 32 safe characters')
    write(os.path.join(tenants, f'{name}.env'),
          [f'RIFF_SECRET={secret}', f'RIFF_PUBLIC_URL={url}', f'RIFF_SERVER_URL={url}'])
    bcrypt = check('CONSOLE_PASSWORD_BCRYPT', values['CONSOLE_PASSWORD_BCRYPT'])
    access = check('ACCESS_TOKEN', values['ACCESS_TOKEN'])
    write(os.path.join(tenants, f'{name}.auth'), [f"HASH='{bcrypt}'", f"ACCESS='{access}'"])
for file in os.listdir(tenants):
    stem, _, ext = file.rpartition('.')
    if ext in ('env', 'auth') and stem not in wanted:
        os.remove(os.path.join(tenants, file))
print(' '.join(sorted(wanted)))
PY
}

case ${1:-} in
  sync)
    # usage: riffctl sync <image-tag>   (spec JSON on stdin)
    image=${2:?usage: riffctl sync <image-tag>}
    [[ $image =~ ^[a-zA-Z0-9._-]+$ ]] || die "invalid image tag"
    docker image inspect "riff:$image" >/dev/null 2>&1 || die "image riff:$image is not on this host"
    mkdir -p "$DEPLOY"
    trap 'rm -f "$DEPLOY/spec.json"' EXIT
    (umask 077; cat > "$DEPLOY/spec.json")
    names=$(write_spec)
    rm -f "$DEPLOY/spec.json"
    docker tag "riff:$image" riff:current
    apply
    # Keep the running image and the previous one for a quick manual rollback.
    docker images riff --format '{{.CreatedAt}}|{{.Tag}}' | sort -r | cut -d'|' -f2 \
      | grep -v -x -e current -e '<none>' -e "$image" | tail -n +2 \
      | xargs -r -I{} docker image rm "riff:{}" >/dev/null 2>&1 || true
    docker image prune -f >/dev/null
    # Daily online database backups, half an hour before Lightsail's 06:00 UTC snapshot.
    echo "30 5 * * * ubuntu /usr/local/bin/riffctl backup > /var/log/riff-backup.log 2>&1" \
      | sudo tee /etc/cron.d/riff-backup >/dev/null
    echo "Deployed riff:$image for: $names"
    ;;
  status)
    conf
    compose ps
    for name in $(tenants); do
      code=$(curl -s -o /dev/null -w '%{http_code}' "https://$name.$BASE_DOMAIN/api/health" || true)
      echo "$name.$BASE_DOMAIN  health=$code"
    done
    ;;
  logs)
    conf
    compose logs --tail=200 -f "app-${2:?usage: riffctl logs <name>}"
    ;;
  backup)
    conf
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    mkdir -p "$BACKUPS"
    for name in $(tenants); do
      # Online, consistent copy through SQLite's backup API inside the running container.
      compose exec -T "app-$name" node --input-type=module -e \
        "import Database from 'better-sqlite3'; const db = new Database('/opt/riff/data/riff.db', { readonly: true }); await db.backup('/opt/riff/data/backup.db'); db.close();"
      compose cp "app-$name:/opt/riff/data/backup.db" "$BACKUPS/$name-$stamp.db"
      compose exec -T "app-$name" rm -f /opt/riff/data/backup.db
      echo "Backed up $name → $BACKUPS/$name-$stamp.db"
    done
    # Keep the 14 newest backups per streamer.
    for name in $(tenants); do
      ls -1t "$BACKUPS/$name-"*.db 2>/dev/null | tail -n +15 | xargs -r rm -f
    done
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
