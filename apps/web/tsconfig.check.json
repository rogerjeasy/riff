{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": ["src/**/*", "test/**/*", "vite.config.ts", "playwright.config.ts", "e2e/**/*"],
  "exclude": ["dist", "node_modules"]
}
