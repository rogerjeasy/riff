# Copy to .env. Every value is optional; defaults run fully offline on loopback.
NODE_ENV=development
RIFF_HOST=127.0.0.1
# Enable only for a deliberate container/private interface; default remains local.
RIFF_ALLOW_REMOTE=false
RIFF_PORT=8787
# Where the console is opened (used for overlay links and OAuth return).
RIFF_PUBLIC_URL=http://localhost:5173
# Where Twitch redirects after sign-in (the Fastify host).
RIFF_SERVER_URL=http://localhost:8787
# Relative paths below resolve from the workspace root.
RIFF_DB_PATH=./data/riff.db

# Runtime compiler: mock = deterministic offline template compiler (no model call);
# codex = Codex SDK at runtime (run `codex login` once; credentials stay in ~/.codex).
RIFF_COMPILER_MODE=mock
# Optional Codex model override and reasoning effort (minimal|low|medium|high).
RIFF_COMPILER_MODEL=
RIFF_COMPILER_EFFORT=low

# Twitch chat via EventSub. Redirect URL: ${RIFF_SERVER_URL}/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# ≥32 characters; seals Twitch tokens at rest (openssl rand -base64 32).
RIFF_SECRET=
# Optional overrides for the Twitch CLI mock EventSub/Helix servers.
TWITCH_EVENTSUB_WS_URL=
TWITCH_HELIX_URL=

LOG_LEVEL=info

# Reserved for future integrations.
OPENAI_API_KEY=
RIFF_TRANSCRIPTION_MODEL=
RIFF_OBS_URL=ws://127.0.0.1:4455
RIFF_OBS_PASSWORD=
